# Example only. Replace placeholders locally; never commit real credentials.
# Spring Boot does NOT automatically load .env files.
# Export these variables into the backend process environment before starting it.
# Docker Compose can load your local file with: --env-file .env
# The existing --env-file NUL command intentionally does not load .env.

# PostgreSQL (compose.postgres.yml exposes port 5433).
# For an existing database, use its existing credentials.
DB_URL=jdbc:postgresql://localhost:5433/diplom_platform
DB_USERNAME=diplom_app
DB_PASSWORD=replace_with_your_database_password
SPRING_PROFILES_ACTIVE=postgres

# Future LLM adapter: these variables are NOT wired into the backend yet.
# Keep the key server-side; do not prefix it with VITE_.
# Confirm model availability and account quotas before enabling requests.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Set true for an HTTPS deployment; false for local HTTP development.
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
