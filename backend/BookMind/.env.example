# Example only. Copy to .env and replace the placeholders; never commit real credentials.
#
# The backend reads only the LLM_* variables from .env in its working directory.
# Database variables must be set in the process environment before starting it
# (see README.md), or passed to Docker Compose with --env-file .env.

# PostgreSQL started by compose.postgres.yml (port 5433).
DB_URL=jdbc:postgresql://localhost:5433/diplom_platform
DB_USERNAME=bookmind
DB_PASSWORD=replace_with_your_database_password
SPRING_PROFILES_ACTIVE=postgres

# DeepSeek API for summaries and the book chat. Keep the key server-side.
# Supported models: deepseek-flash, deepseek-v4-pro.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Set true for an HTTPS deployment; false for local HTTP development.
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
